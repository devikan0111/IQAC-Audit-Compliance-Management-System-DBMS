    "test:integration": "node scripts/integration.mjs",
    "test:mongo": "node --env-file=.env.local scripts/mongo-tests.mjs",
    "db:bootstrap": "node --env-file=.env.local scripts/bootstrap.mjs",
    "db:mongo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mongo-local.ps1",
    "test:sql": "node --env-file=.env.local scripts/sql-qa.mjs",
    "demo": "node --env-file=.env.local scripts/demo.mjs",
    "test:demo": "node --env-file=.env.local scripts/integration-sandbox.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
