MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=iqac_db
MYSQL_USER=iqac_app
# Leave blank on first bootstrap to generate the app password.
MYSQL_PASSWORD=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=iqac_nosql
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Setup uses these separately. Never use the setup account in the web app.
MYSQL_SETUP_USER=root
MYSQL_SETUP_PASSWORD=
